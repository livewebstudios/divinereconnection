---
// Contact. Every way to reach Stella, then the request form. Phone first,
// because many people would rather call than type something personal.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FactCard from '../components/FactCard.astro';
import RequestForm from '../components/islands/RequestForm';
import { serviceOptions } from '../data/services';
import { SITE, FORMS } from '../config';
import { rel } from '../lib/url';

const u = Astro.url;
const schema = [{ '@context': 'https://schema.org', '@type': 'ContactPage', about: { '@id': `${SITE.url}/#business` } }];
---

<Base
  title="Contact Stella Crispo: Divine ReConnection"
  description="Request a session in Montclair, NJ, or remotely. Hours by appointment."
  schema={schema}
>
  <PageHero eyebrow="Contact" title="Let’s talk." intro="Call, write or send a request below. Stella answers every message herself.">
    <Fragment slot="actions">
      <a class="btn" href={SITE.phoneHref}>Call {SITE.phone}</a>
      <a class="btn btn--ghost" href="#request">Send a request</a>
    </Fragment>
    <Fragment slot="aside">
      <FactCard
        title="Good to know"
        rows={[
          { k: 'Sessions', v: 'In person, phone, online' },
          { k: 'In person', v: 'Montclair, NJ' },
          { k: 'Hours', v: 'By appointment' },
        ]}
      />
    </Fragment>
  </PageHero>

  <section class="section" id="request" aria-labelledby="req-title">
    <div class="wrap grid">
      <div class="ways" data-reveal-group>
        <h2 id="req-title" data-reveal>Reach Stella</h2>
        <a class="way" href={SITE.phoneHref} data-reveal>
          <span class="w-k">Phone</span>
          <span class="w-v">{SITE.phone}</span>
        </a>
        <a class="way" href={`mailto:${SITE.email}`} data-reveal>
          <span class="w-k">Email</span>
          <span class="w-v w-email">{SITE.email}</span>
        </a>
        <a class="way" href={SITE.whatsappHref} target="_blank" rel="noopener" data-reveal>
          <span class="w-k">WhatsApp</span>
          <span class="w-v">Message {SITE.phone}</span>
        </a>
        <p class="note" data-reveal>
          Looking to send a prayer request instead? <a href={rel('services/prayer/#request', u)}>Use the prayer form</a>.
        </p>
      </div>
      <div data-reveal>
        <RequestForm client:visible kind="session" action={FORMS.contact} services={serviceOptions} phone={SITE.phone} phoneHref={SITE.phoneHref} email={SITE.email} />
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
  .ways {
    display: grid;
    gap: 1rem;
  }
  .ways h2 {
    margin-bottom: 0.75rem;
  }
  .way {
    display: grid;
    gap: 0.2rem;
    padding: 1.35rem 1.5rem;
    border-radius: 22px;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    text-decoration: none;
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      border-color 0.3s;
  }
  .way:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
    border-color: var(--color-lavender-soft);
  }
  .w-k {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-purple);
  }
  .w-v {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.15;
    color: var(--color-purple-deep);
  }
  .w-email {
    font-size: 1.25rem;
    word-break: break-all;
  }
  .note {
    margin-top: 0.5rem;
    color: var(--color-gray-600);
  }
</style>
