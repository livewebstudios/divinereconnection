---
// Testimonials. Grouped by category, as on her current site, with a filter
// so each visitor finds the kind of experience they care about.
// The support line is required on this page.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TestimonialNote from '../components/TestimonialNote.astro';
import TestimonialFilter from '../components/islands/TestimonialFilter';
import { testimonials, categories } from '../data/testimonials';
import { SUPPORT_LINE } from '../data/services';
import { SITE } from '../config';
import { rel } from '../lib/url';

const u = Astro.url;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Testimonials',
    about: { '@id': `${SITE.url}/#business` },
  },
];
---

<Base title="Testimonials: Divine ReConnection" description="What people say after working with Stella Crispo." schema={schema}>
  <PageHero
    eyebrow="Testimonials"
    title="In their own words."
    intro="Notes from people who have worked with Stella, shared with their permission. Initials only, to keep their privacy."
  >
    <Fragment slot="aside">
      <TestimonialNote t={testimonials[0]} class="hero-note" />
    </Fragment>
  </PageHero>

  <section class="section" aria-label="All testimonials">
    <div class="wrap">
      <TestimonialFilter client:visible items={testimonials} categories={categories} />

      <div class="after">
        <p class="support"><strong>Please note.</strong> {SUPPORT_LINE}</p>
        <div class="share">
          <p>Worked with Stella? She would love to hear how it went.</p>
          <a class="text-link" href={rel('contact/', u)}>Share your experience <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  :global(.hero-note) {
    width: 360px;
    rotate: 3deg;
  }
  .after {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }
  @media (min-width: 900px) {
    .after {
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
    }
  }
  .support {
    margin: 0;
    padding: 1.4rem 1.6rem;
    border-radius: 20px;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-left: 4px solid var(--color-rose);
  }
  .share p {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--color-purple-deep);
    margin-bottom: 0.75rem;
  }
</style>
