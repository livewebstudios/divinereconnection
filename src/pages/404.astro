---
// Not found. Links here are root-relative on purpose (see src/lib/url.ts).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { rel } from '../lib/url';
const u = Astro.url;
---

<Base title="Page not found: Divine ReConnection" description="This page could not be found." noindex>
  <PageHero eyebrow="Page not found" title="This page drifted out to sea." intro="It may have moved when the site was rebuilt. These will get you where you were going.">
    <Fragment slot="actions">
      <a class="btn" href={rel('', u)}>Go to the home page</a>
      <a class="btn btn--ghost" href={rel('services/', u)}>See services</a>
      <a class="btn btn--ghost" href={rel('contact/', u)}>Contact Stella</a>
    </Fragment>
  </PageHero>
</Base>
