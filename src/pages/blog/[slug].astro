---
// Blog post. A single readable column, with a way back and a way forward.
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE } from '../../config';
import { rel } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const u = Astro.url;
const html = await marked.parse(p.data.body);
const date = p.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: p.data.title,
    datePublished: p.data.date.toISOString(),
    author: { '@type': 'Person', name: SITE.owner },
    publisher: { '@id': `${SITE.url}/#business` },
    mainEntityOfPage: `${SITE.url}/blog/${p.id}/`,
  },
];
---

<Base title={`${p.data.title}: Divine ReConnection Blog`} description={p.data.description} schema={schema}>
  <PageHero eyebrow={date} title={p.data.title} />
  <section class="section">
    <article class="wrap prose" data-reveal set:html={html} />
    <div class="wrap back">
      <a class="text-link" href={rel('blog/', u)}><span aria-hidden="true">←</span> All posts</a>
      <a class="btn" href={rel('contact/', u)}>Reach out to Stella <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .prose {
    max-width: 68ch;
    font-size: var(--step-1);
    line-height: 1.7;
    color: #3f3a4c;
  }
  .prose :global(p:first-child::first-letter) {
    float: left;
    font-family: var(--font-display);
    font-size: 4.5em;
    line-height: 0.8;
    margin: 0.08em 0.1em 0 0;
    color: var(--color-purple-deep);
  }
  .prose :global(h2),
  .prose :global(h3) {
    margin: 2.5rem 0 1rem;
  }
  .back {
    max-width: 68ch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-gray-200);
  }
</style>
