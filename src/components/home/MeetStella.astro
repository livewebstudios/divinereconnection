---
// Meet Stella. Trust for every door comes from the person, so this is the
// one long-form section on the home page: who she is, the line about her own
// divine connection at the center of the work, and the credential that
// answers "is she trained?".
// Photo: Stella's own portrait (round 3) in the arch frame, with her
// signature over a soft dark-purple scrim at the bottom left.
import { rel } from '../../lib/url';
import { FAITH_LINE } from '../../data/services';
import Petal from '../Petal.astro';
import Photo from '../Photo.astro';
import Star from '../Star.astro';

const u = Astro.url;
---

<section class="section meet" aria-labelledby="meet-title" data-parallax-scope>
  <div class="wrap grid">
    <div class="visual">
      <div class="frame" data-parallax="0.08">
        <Photo
          name="stella-portrait"
          widths={[600, 960]}
          width={960}
          height={1200}
          variant="arch"
          sizes="(min-width: 520px) 480px, calc(100vw - 2rem)"
          alt="Stella Crispo outdoors, looking into the distance."
        >
          <div class="sig-over"><img src={rel('images/signature-white.svg', u)} alt="" width="473" height="153" loading="lazy" /></div>
        </Photo>
      </div>
      <div class="cred" data-parallax="0.22" data-reveal>
        <p class="cred-k">Certified Pranic Healer</p>
        <ul>
          <li>Advanced Pranic Healing</li>
          <li>Pranic Psychotherapy</li>
          <li>Pranic Crystal Healing</li>
          <li>Pranic Psychic Self-Defense</li>
        </ul>
      </div>
      <div class="petal-a" data-parallax="0.35" data-parallax-rotate="50" aria-hidden="true"><Petal tone="lavender" size={56} /></div>
      <div class="star-a" data-parallax="0.28" aria-hidden="true"><Star tone="lavender" size={20} /></div>
      <div class="star-b" data-parallax="0.42" aria-hidden="true"><Star tone="rose" size={12} /></div>
    </div>

    <div class="text" data-reveal-group>
      <p class="eyebrow" data-reveal>Meet Stella</p>
      <h2 id="meet-title" data-reveal>Hi, I’m Stella Crispo.</h2>
      <p data-reveal>
        I come from a psychic family and I have sensed things I could not explain since I was a child. In 2017, I began studying Pranic
        Healing and the work has shaped my life ever since.
      </p>
      <p data-reveal>
        Today, I pray with people, offer no-touch energy healing and give honest guidance to anyone who feels disconnected from
        themselves, from the people they have lost or from God. Some come once. Some come back for years. Everyone gets my full
        attention.
      </p>
      <blockquote class="faith" data-reveal>
        <p>{FAITH_LINE}</p>
      </blockquote>
      <ul class="ways" data-reveal>
        <li><strong>In person</strong><span>Montclair, NJ</span></li>
        <li><strong>By phone</strong><span>Wherever you are</span></li>
        <li><strong>Remote</strong><span>At a distance and local to international</span></li>
      </ul>
      <a class="text-link" href={rel('about/', u)} data-reveal>Read Stella’s story <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  .visual {
    position: relative;
    max-width: 480px;
    width: 100%;
    margin-inline: auto;
    padding-bottom: 3rem;
  }
  .frame {
    aspect-ratio: 4 / 5;
    border-radius: 200px 200px 28px 28px;
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }
  /* Signature over a soft dark-purple scrim, bottom left (decorative). */
  .sig-over {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0 8% 8%;
    background: var(--scrim-signature);
    pointer-events: none;
  }
  .sig-over img {
    width: 45%;
    height: auto;
  }
  .cred {
    position: absolute;
    right: -1.5rem;
    bottom: 0;
    width: 260px;
    padding: 1.25rem 1.35rem;
    border-radius: 20px;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    box-shadow: var(--shadow-lift);
  }
  .cred-k {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-purple-deep);
    margin-bottom: 0.6rem;
  }
  .cred ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-size: 0.875rem;
    color: var(--color-gray-600);
  }
  .cred li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .cred li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-rose);
    transform: translateY(-2px);
  }
  .petal-a {
    position: absolute;
    left: -1.5rem;
    top: 18%;
  }
  .star-a,
  .star-b {
    position: absolute;
    pointer-events: none;
  }
  .star-a {
    left: -1.25rem;
    top: 5%;
  }
  .star-b {
    left: -0.5rem;
    top: 34%;
  }
  @media (max-width: 560px) {
    .star-a {
      left: -0.25rem;
      top: 2%;
    }
    .star-b {
      display: none;
    }
  }

  .text h2 {
    margin: 1rem 0 1.5rem;
  }
  /* Both paragraphs share one size and color (Stella, 11-23) */
  .text > p:not(.eyebrow) {
    color: var(--color-gray-600);
    max-width: 58ch;
  }
  .faith {
    margin: 2rem 0;
    padding: 1.25rem 0 1.25rem 1.5rem;
    border-left: 3px solid var(--color-rose);
  }
  .faith p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--color-purple-deep);
  }
  .ways {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--color-gray-200);
    border-radius: 18px;
    background: var(--color-white);
    overflow: hidden;
  }
  .ways li {
    display: grid;
    gap: 0.15rem;
    padding: 1rem 1.1rem;
  }
  .ways li + li {
    border-left: 1px solid var(--color-gray-200);
  }
  .ways strong {
    color: var(--color-purple-deep);
    font-size: 0.9375rem;
  }
  .ways span {
    font-size: 0.8125rem;
    color: var(--color-gray-600);
  }
  @media (max-width: 560px) {
    .ways {
      grid-template-columns: 1fr;
    }
    .ways li + li {
      border-left: 0;
      border-top: 1px solid var(--color-gray-200);
    }
    /* Phones: the card tucks just under the frame (24px overlap) so it
       never covers the signature at the bottom left of the photo. */
    .visual {
      padding-bottom: 0;
    }
    .cred {
      position: relative;
      right: auto;
      width: 240px;
      margin: -1.5rem -0.5rem 0 auto;
    }
  }
</style>
