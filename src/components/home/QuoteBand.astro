---
// Quote band (round 3). Stella asked for this Alan Paton line "somewhere";
// it sits between Meet Stella and How it works, on her own sunset photo,
// as the pause between who she is and how to start. The deep purple wash
// is the purple hue at full strength: heaviest on the right where the words
// sit over the treeline, thin on the left so the sun still shows through.
// Upright, not italic (round 2 keeps italics to the word "divine").
import { rel } from '../../lib/url';
import Star from '../Star.astro';

const u = Astro.url;
const set = (name: string, ext: string, widths: number[]) =>
  widths.map((w) => `${rel(`images/photos/${name}-${w}.${ext}`, u)} ${w}w`).join(', ');
const tallSizes = 'calc(100vw - 2rem)';
const bandSizes = 'min(100vw - 5rem, 1360px)';
---

<div class="qb" data-parallax-scope>
  <div class="qb-stage">
    <div class="qb-photo" data-parallax="0.06" aria-hidden="true">
      <picture>
        <source media="(max-width: 640px)" type="image/webp" srcset={set('sunset-tall', 'webp', [480, 800])} sizes={tallSizes} />
        <source media="(max-width: 640px)" srcset={set('sunset-tall', 'jpg', [480, 800])} sizes={tallSizes} />
        <source type="image/webp" srcset={set('sunset-band', 'webp', [960, 1600])} sizes={bandSizes} />
        <img
          src={rel('images/photos/sunset-band-1600.jpg', u)}
          srcset={set('sunset-band', 'jpg', [960, 1600])}
          sizes={bandSizes}
          width="1600"
          height="1000"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
    <div class="qb-wash" aria-hidden="true"></div>
    <div class="qb-stars" aria-hidden="true">
      <span class="qs qs-1"><Star tone="white" size={18} /></span>
      <span class="qs qs-2"><Star tone="white" size={12} /></span>
      <span class="qs qs-3"><Star tone="white" size={24} /></span>
    </div>

    <figure class="qb-quote" data-reveal>
      <blockquote>
        <p>
          “St. Francis of Assisi taught me that there is a wound in the Creation and that the greatest use we could make of our lives
          was to ask to be made a healer of it.”
        </p>
      </blockquote>
      <figcaption>Alan Paton</figcaption>
    </figure>
  </div>
</div>

<style>
  .qb {
    padding: 0 var(--gutter);
  }
  .qb-stage {
    position: relative;
    max-width: 1360px;
    margin-inline: auto;
    min-height: clamp(460px, 40vw, 620px);
    display: grid;
    align-items: center;
    padding: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(1.5rem, 0.5rem + 5vw, 6rem);
    border-radius: 32px;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-purple-ink);
  }

  /* Taller than the stage so the slow parallax never shows an edge */
  .qb-photo {
    position: absolute;
    inset: -12% 0;
    z-index: -2;
  }
  .qb-photo picture,
  .qb-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .qb-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      270deg,
      color-mix(in srgb, var(--color-purple-ink) 90%, transparent) 0%,
      color-mix(in srgb, var(--color-purple-ink) 86%, transparent) 56%,
      color-mix(in srgb, var(--color-purple-ink) 52%, transparent) 80%,
      color-mix(in srgb, var(--color-purple-ink) 28%, transparent) 100%
    );
  }

  /* Words on the right, over the dark treeline; the sun shows on the left */
  .qb-quote {
    justify-self: end;
    margin: 0;
    max-width: 26ch;
    font-size: clamp(1.5rem, 1.15rem + 1.5vw, 2.6rem);
  }
  .qb-quote blockquote {
    margin: 0;
  }
  .qb-quote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-style: normal;
    font-size: 1em;
    line-height: 1.2;
    color: var(--color-on-dark);
    text-wrap: pretty;
  }
  .qb-quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
  }
  .qb-quote figcaption::before {
    content: '';
    width: 28px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-rose);
  }

  /* Three white stars in the sky, far side from the words */
  .qb-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .qs {
    position: absolute;
  }
  .qs-1 {
    top: 10%;
    left: 8%;
  }
  .qs-2 {
    top: 22%;
    left: 20%;
  }
  .qs-3 {
    top: 7%;
    left: 31%;
  }

  /* Tablets: the words cover more of the width, so the heavy part of the
     wash reaches further across (contrast measured in SESSION_SUMMARY.md). */
  @media (min-width: 641px) and (max-width: 1099px) {
    .qb-wash {
      background: linear-gradient(
        270deg,
        color-mix(in srgb, var(--color-purple-ink) 90%, transparent) 0%,
        color-mix(in srgb, var(--color-purple-ink) 88%, transparent) 68%,
        color-mix(in srgb, var(--color-purple-ink) 60%, transparent) 88%,
        color-mix(in srgb, var(--color-purple-ink) 40%, transparent) 100%
      );
    }
  }

  /* Phones: the tall crop, an even wash, words centered over the water line */
  @media (max-width: 640px) {
    .qb-stage {
      min-height: 520px;
      border-radius: 28px;
    }
    .qb-wash {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-purple-ink) 55%, transparent) 0%,
        color-mix(in srgb, var(--color-purple-ink) 84%, transparent) 26%,
        color-mix(in srgb, var(--color-purple-ink) 84%, transparent) 78%,
        color-mix(in srgb, var(--color-purple-ink) 60%, transparent) 100%
      );
    }
    .qb-quote {
      justify-self: start;
    }
    .qs-1 {
      top: 5%;
      left: auto;
      right: 8%;
    }
    .qs-2 {
      top: 10%;
      left: auto;
      right: 26%;
    }
    .qs-3 {
      top: 4%;
      left: 10%;
    }
  }
</style>
