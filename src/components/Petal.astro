---
// A single rose petal, softly shaded. Stella welcomed petals as a second
// motif; they carry the motion between sections instead of decoration for its own sake.
interface Props {
  class?: string;
  tone?: 'lavender' | 'deep' | 'blush';
  size?: number;
  [key: string]: unknown;
}
const { class: cls = '', tone = 'lavender', size = 64, ...rest } = Astro.props;
const id = `pg-${Math.random().toString(36).slice(2, 8)}`;
const stops = {
  lavender: ['#F3EDF8', '#C9B5DC', '#9C7FBA'],
  deep: ['#D8C8EA', '#8D6CB8', '#5B3F92'],
  blush: ['#FBF6FA', '#E4D3EA', '#B79ACB'],
}[tone];
---

<svg class={`petal ${cls}`} width={size} height={size} viewBox="0 0 100 104" aria-hidden="true" {...rest}>
  <defs>
    <radialGradient id={id} cx="42%" cy="34%" r="72%">
      <stop offset="0" stop-color={stops[0]}></stop>
      <stop offset="0.55" stop-color={stops[1]}></stop>
      <stop offset="1" stop-color={stops[2]}></stop>
    </radialGradient>
  </defs>
  <path
    d="M14 30C18 12 40 4 56 8c18 4 36 14 34 34-2 22-24 44-40 56-10-8-32-28-38-48-2-8 0-14 2-20Z"
    fill={`url(#${id})`}></path>
  <path d="M20 27c14-14 40-17 62-3" stroke="#fff" stroke-opacity="0.55" stroke-width="2.5" stroke-linecap="round" fill="none"></path>
  <path d="M50 96C46 70 44 44 50 18" stroke="#fff" stroke-opacity="0.22" stroke-width="1" fill="none"></path>
</svg>

<style>
  .petal {
    filter: drop-shadow(0 10px 14px rgba(46, 26, 85, 0.22));
    overflow: visible;
  }
</style>
