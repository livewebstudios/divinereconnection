---
// Wrapper for the rendered ocean (src/scripts/ocean.ts). The CSS gradient
// underneath is the still fallback for no WebGL and the first paint.
// horizon / horizonMobile: height of the horizon from the bottom, 0 to 1.
interface Props {
  horizon?: number;
  horizonMobile?: number;
  showToggle?: boolean;
}
const { horizon = 0.36, horizonMobile = 0.3, showToggle = true } = Astro.props;
---

<div class="ocean" data-ocean data-horizon={horizon} data-horizon-mobile={horizonMobile}>
  <canvas aria-hidden="true"></canvas>
</div>
{
  showToggle && (
    <button class="ocean-toggle" type="button" data-ocean-toggle aria-pressed="false">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
        <rect class="i-pause" x="3" y="2" width="3" height="10" rx="1" fill="currentColor" />
        <rect class="i-pause" x="8" y="2" width="3" height="10" rx="1" fill="currentColor" />
        <path class="i-play" d="M4 2.5v9l7.5-4.5z" fill="currentColor" />
      </svg>
      <span data-label>Pause the water</span>
    </button>
  )
}

<style>
  .ocean {
    --horizon: 64%;
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #f3f0f7 0%,
      #e6def0 calc(var(--horizon) - 8%),
      #d1c5e2 var(--horizon),
      #8a6fb8 calc(var(--horizon) + 4%),
      #553c8a calc(var(--horizon) + 22%),
      #2a184c 100%
    );
  }
  .ocean canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .ocean:global(.is-live) canvas {
    opacity: 1;
  }
  .ocean-toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(30, 16, 58, 0.45);
    color: var(--color-white);
    font: 600 0.75rem/1 var(--font-body);
    letter-spacing: 0.04em;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }
  .ocean-toggle:hover {
    background: rgba(30, 16, 58, 0.65);
  }
  .i-play {
    display: none;
  }
  .ocean-toggle[aria-pressed='true'] .i-play {
    display: block;
  }
  .ocean-toggle[aria-pressed='true'] .i-pause {
    display: none;
  }
</style>
