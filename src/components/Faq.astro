---
// FAQ as native <details>, so it works without JavaScript and stays
// keyboard friendly. Marked up as FAQPage by the page that uses it.
import type { Faq as FaqItem } from '../data/services';
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="faq" data-reveal-group>
  {
    items.map((f, i) => (
      <details class="q" open={i === 0} data-reveal>
        <summary>
          <span>{f.q}</span>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M5 10h10M10 5v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }
  .q {
    border-radius: 20px;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    transition:
      box-shadow 0.3s,
      border-color 0.3s;
  }
  .q[open] {
    border-color: var(--color-lavender-soft);
    box-shadow: var(--shadow-soft);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    cursor: pointer;
    font-weight: 700;
    color: var(--color-purple-deep);
    border-radius: 20px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    flex: none;
    transition: transform 0.4s var(--ease-out);
  }
  .q[open] summary svg {
    transform: rotate(45deg);
  }
  .q p {
    margin: 0;
    padding: 0 1.35rem 1.3rem;
    color: var(--color-gray-600);
  }
  .q::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease-out),
      content-visibility 0.45s allow-discrete;
  }
  .q[open]::details-content {
    block-size: auto;
  }
  :global(html) {
    interpolate-size: allow-keywords;
  }
</style>
