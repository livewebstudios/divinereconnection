---
// Inner-page hero: the same ocean stage as the home page at a shorter
// height, so every page opens on the brand's water without repeating the
// home hero's objects. Text always sits on the sky for contrast.
// Slot "aside" takes one floating object that says what the page is for.
// Every page opens with the same Stella Crispo lockup as the home hero, at
// the same size and position, so her name leads on every page.
import Ocean from './Ocean.astro';
import Star from './Star.astro';
import { rel } from '../lib/url';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
const u = Astro.url;
---

<section class="ph" aria-labelledby="page-title">
  <div class="ph-stage">
    <Ocean horizon={0.2} horizonMobile={0.14} showToggle={false} />
    <div class="stars" aria-hidden="true" data-parallax="0.1">
      <span class="s1"><Star tone="lavender" size={20} /></span>
      <span class="s2"><Star tone="rose" size={12} /></span>
      <span class="s3"><Star tone="lavender" size={14} /></span>
      <span class="s4"><Star tone="rose" size={16} /></span>
    </div>
    <div class="ph-inner">
      <div class="ph-copy" data-parallax="0.12">
        <picture class="lockup" data-reveal>
          <source media="(max-width: 640px)" srcset={rel('images/lockup-mobile-deep-purple.svg', u)} width="1212" height="207" />
          <img src={rel('images/lockup-deep-purple.svg', u)} alt="Stella Crispo, Divine ReConnection" width="1184" height="173" fetchpriority="high" />
        </picture>
        {eyebrow && <p class="eyebrow ph-eyebrow" data-reveal>{eyebrow}</p>}
        <h1 id="page-title" data-reveal>{title}</h1>
        {intro && <p class="ph-intro" data-reveal>{intro}</p>}
        {Astro.slots.has('actions') && <div class="ph-actions" data-reveal><slot name="actions" /></div>}
      </div>
      {
        Astro.slots.has('aside') && (
          <div class="ph-aside" aria-hidden="true" data-parallax="0.3">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .ph {
    padding: 0 var(--gutter);
    margin-top: -76px;
  }
  @media (max-width: 639px) {
    .ph {
      margin-top: -66px;
    }
  }
  .ph-stage {
    position: relative;
    max-width: 1360px;
    margin-inline: auto;
    border-radius: 32px;
    overflow: hidden;
    isolation: isolate;
  }

  /* Stars in the sky (round 3). Never over text or a control; checked at
     360 to 1920. Behind the copy and the floating objects. */
  .stars {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .stars > span {
    position: absolute;
  }
  .s1 {
    top: 18%;
    right: 6%;
  }
  .s2 {
    top: 13%;
    right: 24%;
  }
  .s3 {
    top: 24%;
    right: 40%;
  }
  .s4 {
    bottom: 26%;
    right: 8%;
  }
  /* Below 960px the copy fills the width: stars sit in the strip of sky
     between the last line of copy and the water. */
  @media (max-width: 959px) {
    .s1,
    .s2,
    .s3 {
      top: auto;
    }
    .s1 {
      bottom: clamp(4.25rem, 3rem + 3vw, 6rem);
      right: 12%;
    }
    .s2 {
      bottom: clamp(5.25rem, 4rem + 3vw, 7rem);
      right: 34%;
    }
    .s3 {
      bottom: clamp(4rem, 3rem + 3vw, 5.75rem);
      right: 58%;
    }
    .s4 {
      display: none;
    }
  }
  .ph-inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 2rem;
    align-items: center;
    min-height: clamp(520px, 66svh, 640px);
    padding: calc(var(--header-clear) + clamp(2rem, 0.5rem + 4vw, 4.5rem)) clamp(1.25rem, 0.5rem + 4vw, 4.5rem) clamp(7rem, 5rem + 6vw, 10rem);
  }
  /* Copy starts at the top, so the lockup lands in the same spot as on the
     home hero no matter how short the page's intro is. */
  .ph-copy {
    align-self: start;
  }
  /* Same lockup size and spacing as the home hero (HomeHero.astro). */
  .lockup {
    display: block;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }
  .lockup img {
    width: clamp(320px, 42vw, 600px);
    max-width: 100%;
    height: auto;
  }
  @media (max-width: 640px) {
    .lockup img {
      width: min(88vw, 360px);
    }
  }
  @media (min-width: 960px) {
    .ph-inner {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .ph-eyebrow {
    background: rgba(255, 255, 255, 0.75);
  }
  h1 {
    margin: 1.2rem 0 1.1rem;
    font-size: clamp(2.2rem, 1.36rem + 3.05vw, 4rem);
    line-height: 1.02;
    color: var(--color-purple-ink);
    max-width: 16ch;
  }
  .ph-intro {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 46ch;
  }
  .ph-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .ph-aside {
    position: relative;
    display: grid;
    place-items: center;
  }
  @media (max-width: 959px) {
    .ph-aside {
      display: none;
    }
  }
</style>
